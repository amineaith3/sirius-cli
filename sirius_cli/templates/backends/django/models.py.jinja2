from django.db import models


{% for table_name, columns in schemas.items() %}
{% set class_name = table_name.replace('_', ' ').title().replace(' ', '') %}
class {{ class_name }}(models.Model):
    class Meta:
        db_table = "{{ table_name }}"

    {% for col in columns %}
    {% if col.is_pk %}
    id = models.AutoField(primary_key=True)
    {% elif col.foreign_key %}
    {% set ref_table = col.foreign_key.split('.')[0] %}
    {% set ref_class = ref_table.replace('_', ' ').title().replace(' ', '') %}
    {% set field_name = col.name[:-3] if col.name.endswith('_id') else col.name %}
    {{ field_name }} = models.ForeignKey(
        "{{ ref_class }}",
        on_delete=models.SET_NULL,
        null=True,
        blank=True,
        db_column="{{ col.name }}",
    )
    {% elif col.type == 'Integer' %}
    {{ col.name }} = models.IntegerField(null=True, blank=True)
    {% elif col.type == 'Float' %}
    {{ col.name }} = models.FloatField(null=True, blank=True)
    {% elif col.type == 'Boolean' %}
    {{ col.name }} = models.BooleanField(null=True, blank=True)
    {% elif col.type == 'DateTime' %}
    {{ col.name }} = models.DateTimeField(null=True, blank=True)
    {% else %}
    {{ col.name }} = models.TextField(null=True, blank=True)
    {% endif %}
    {% endfor %}

    def __str__(self):
        return f"{{ class_name }}(id={self.pk})"


{% endfor %}

{% if auth %}
from django.contrib.auth.models import AbstractBaseUser, BaseUserManager, PermissionsMixin


class AppUserManager(BaseUserManager):
    def create_user(self, username, password=None):
        if not username:
            raise ValueError("Username is required")
        user = self.model(username=username)
        user.set_password(password)
        user.save(using=self._db)
        return user

    def create_superuser(self, username, password=None):
        user = self.create_user(username, password)
        user.is_staff = True
        user.is_superuser = True
        user.save(using=self._db)
        return user


class AppUser(AbstractBaseUser, PermissionsMixin):
    username = models.CharField(max_length=150, unique=True)
    is_active = models.BooleanField(default=True)
    is_staff = models.BooleanField(default=False)

    objects = AppUserManager()

    USERNAME_FIELD = "username"
    REQUIRED_FIELDS = []

    class Meta:
        db_table = "app_users"

    def __str__(self):
        return self.username
{% endif %}
