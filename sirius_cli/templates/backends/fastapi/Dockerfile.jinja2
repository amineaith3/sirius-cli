FROM python:3.10-slim

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt .
RUN pip install --default-timeout=1000 --no-cache-dir -r requirements.txt

COPY . /app/backend/

# Security Hardening: Run as non-privileged system user
RUN groupadd -g 999 appuser && useradd -r -u 999 -g appuser appuser && chown -R appuser:appuser /app
USER appuser

EXPOSE {{ port }}

# We assume uvicorn is installed and backend is a python package
CMD ["uvicorn", "backend.main:app", "--host", "0.0.0.0", "--port", "{{ port }}"]
